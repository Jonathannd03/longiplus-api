{
  "name": "kelasi-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
    "dev:worker": "tsx watch --tsconfig tsconfig.json src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^8.3.1",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/terminus": "^10.2.3",
    "bullmq": "^5.34.2",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "keycloak-js": "^26.2.4",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "uuidv7": "^1.2.1",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core"
    ]
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@swc/core": "^1.16.20",
    "@testcontainers/postgresql": "^10.23.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "testcontainers": "^10.23.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
